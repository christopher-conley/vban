<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NAudio.Core instead of the NAudio meta-package: on the windows TFM the
      meta-package drags in NAudio.WinForms, which a console tool has no use
      for. The focused packages below are the same version and the same code.
    -->
    <PackageReference Include="NAudio.Core" Version="3.0.0-preview.16" />
    <PackageReference Include="NAudio.Alsa" Version="3.0.0-preview.16" />
    <!--
      NAudio.PipeWirePlay was evaluated for the pipewire backend but is
      compiled against NAudio.Core 2.3 (array-based IWaveProvider.Read) and
      throws MissingMethodException against Core 3.0's span-based interface.
      PipeWireBackend drives pw-play/pw-record directly instead.
    -->
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="NAudio.Wasapi" Version="3.0.0-preview.16" />
    <PackageReference Include="NAudio.WinMM" Version="3.0.0-preview.16" />
    <PackageReference Include="NAudio.Asio" Version="3.0.0-preview.16" />
  </ItemGroup>
</Project>
